\id XXA bhagavad-gita
\usfm 3.1
\ide UTF-8
\rem anagnosis work=bhagavad-gita edition=besant.en lang=en
\rem source Wikisource, Bhagavad-Gita (Besant 4th), https://en.wikisource.org/wiki/Bhagavad-Gita_(Besant_4th)
