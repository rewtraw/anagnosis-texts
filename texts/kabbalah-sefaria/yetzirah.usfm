\id XXA yetzirah
\usfm 3.1
\ide UTF-8
\rem anagnosis work=yetzirah edition=sefaria.en lang=en urn=urn:cts:anagnosis:kabbalah.yetzirah.sefaria-eng cite=cp.vp
