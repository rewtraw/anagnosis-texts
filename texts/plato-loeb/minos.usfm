\id XXA minos
\usfm 3.1
\ide UTF-8
\rem anagnosis work=minos edition=loeb.eng lang=en
\rem source Perseus Digital Library (https://www.perseus.tufts.edu/), CC BY-SA 4.0; Plato, Minos
