\id XXA meno
\usfm 3.1
\ide UTF-8
\rem anagnosis work=meno edition=loeb.en lang=en urn=urn:cts:greekLit:tlg0059.tlg024.perseus-eng2 cite=vp
\rem source Perseus Digital Library (https://www.perseus.tufts.edu/), github.com/PerseusDL/canonical-greekLit, CC BY-SA 4.0
