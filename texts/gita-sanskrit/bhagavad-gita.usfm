\h Bhagavad Gita
\toc1 Bhagavad Gita
\mt1 Bhagavad Gita
\c 1
\cp 1
\p
\v 1 \vp 1\vp* \zsay-s |who="Dhritarâshtra"\*\zsp धृतराष्ट्र उवाच ।|who="Dhritarâshtra"\zsp*
\q1 धर्मक्षेत्रे कुरुक्षेत्रे समवेता युयुत्सवः ।
\q1 मामकाः पाण्डवाश्चैव किमकुर्वत सञ्जय ॥\zsay-e\*
\v 2 \vp 2\vp* \zsay-s |who="Sanjaya"\*\zsp सञ्जय उवाच ।|who="Sanjaya"\zsp*
\q1 दृष्ट्वा तु पाण्डवानीकं व्यूढं दुर्योधनस्तदा ।
\q1 आचार्यमुपसङ्गम्य राजा वचनमब्रवीत् ॥\zsay-e\*
\v 3 \vp 3\vp* \zsay-s |who="Sanjaya"\*पश्यैतां पाण्डुपुत्राणामाचार्य महतीं चमूम् ।
\q1 व्यूढां द्रुपदपुत्रेण तव शिष्येण धीमता ॥\zsay-e\*
\v 4 \vp 4\vp* \zsay-s |who="Sanjaya"\*अत्र शूरा महेष्वासा भीमार्जुनसमा युधि ।
\q1 युयुधानो विराटश्च द्रुपदश्च महारथः ॥\zsay-e\*
\v 5 \vp 5\vp* \zsay-s |who="Sanjaya"\*धृष्टकेतुश्चेकितानः काशिराजश्च वीर्यवान् ।
\q1 पुरुजित्कुन्तिभोजश्च शैब्यश्च नरपुङ्गवः ॥\zsay-e\*
\v 6 \vp 6\vp* \zsay-s |who="Sanjaya"\*युधामन्युश्च विक्रान्त उत्तमौजाश्च वीर्यवान् ।
\q1 सौभद्रो द्रौपदेयाश्च सर्व एव महारथाः ॥\zsay-e\*
\v 7 \vp 7\vp* \zsay-s |who="Sanjaya"\*अस्माकं तु विशिष्टा ये तान्निबोध द्विजोत्तम ।
\q1 नायका मम सैन्यस्य संज्ञार्थं तान्ब्रवीमि ते ॥\zsay-e\*
\v 8 \vp 8\vp* \zsay-s |who="Sanjaya"\*भवान्भीष्मश्च कर्णश्च कृपश्च समितिञ्जयः ।
\q1 अश्वत्थामा विकर्णश्च सौमदत्तिस्तथैव च ॥\zsay-e\*
\v 9 \vp 9\vp* \zsay-s |who="Sanjaya"\*अन्ये च बहवः शूरा मदर्थे त्यक्तजीविताः ।
\q1 नानाशस्त्रप्रहरणाः सर्वे युद्धविशारदाः ॥\zsay-e\*
\v 10 \vp 10\vp* \zsay-s |who="Sanjaya"\*अपर्याप्तं तदस्माकं बलं भीष्माभिरक्षितम् ।
\q1 पर्याप्तं त्विदमेतेषां बलं भीमाभिरक्षितम् ॥\zsay-e\*
\v 11 \vp 11\vp* \zsay-s |who="Sanjaya"\*अयनेषु च सर्वेषु यथाभागमवस्थिताः ।
\q1 भीष्ममेवाभिरक्षन्तु भवन्तः सर्व एव हि ॥ ॥\zsay-e\*
\v 12 \vp 12\vp* \zsay-s |who="Sanjaya"\*तस्य सञ्जनयन्हर्षं कुरुवृद्धः पितामहः ।
\q1 सिंहनादं विनद्योच्चैः शङ्खं दध्मौ प्रतापवान् ॥\zsay-e\*
\v 13 \vp 13\vp* \zsay-s |who="Sanjaya"\*ततः शङ्खाश्च भेर्यश्च पणवानकगोमुखाः ।
\q1 सहसैवाभ्यहन्यन्त स शब्दस्तुमुलोऽभवत् ॥\zsay-e\*
\v 14 \vp 14\vp* \zsay-s |who="Sanjaya"\*ततः श्वेतैर्हयैर्युक्ते महति स्यन्दने स्थितौ ।
\q1 माधवः पाण्डवश्चैव दिव्यौ शङ्खौ प्रदध्मतुः ॥\zsay-e\*
\v 15 \vp 15\vp* \zsay-s |who="Sanjaya"\*पाञ्चजन्यं हृषीकेशो देवदत्तं धनञ्जयः ।
\q1 पौण्ड्रं दध्मौ महाशङ्खं भीमकर्मा वृकोदरः ॥\zsay-e\*
\v 16 \vp 16\vp* \zsay-s |who="Sanjaya"\*अनन्तविजयं राजा कुन्तीपुत्रो युधिष्ठिरः ।
\q1 नकुलः सहदेवश्च सुघोषमणिपुष्पकौ ॥\zsay-e\*
\v 17 \vp 17\vp* \zsay-s |who="Sanjaya"\*काश्यश्च परमेष्वासः शिखण्डी च महारथः ।
\q1 धृष्टद्युम्नो विराटश्च सात्यकिश्चापराजितः ॥\zsay-e\*
\v 18 \vp 18\vp* \zsay-s |who="Sanjaya"\*द्रुपदो द्रौपदेयाश्च सर्वशः पृथिवीपते ।
\q1 सौभद्रश्च महाबाहुः शङ्खान्दध्मुः पृथक्पृथक् ॥\zsay-e\*
\v 19 \vp 19\vp* \zsay-s |who="Sanjaya"\*स घोषो धार्तराष्ट्राणां हृदयानि व्यदारयत् ।
\q1 नभश्च पृथिवीं चैव तुमुलो व्यनुनादयन् ॥\zsay-e\*
\v 20 \vp 20\vp* \zsay-s |who="Sanjaya"\*अथ व्यवस्थितान्दृष्ट्वा धार्तराष्ट्रान्कपिध्वजः ।
\q1 प्रवृत्ते शस्त्रसम्पाते धनुरुद्यम्य पाण्डवः ॥\zsay-e\*
\v 21 \vp 21\vp* \zsay-s |who="Sanjaya"\*हृषीकेशं तदा वाक्यमिदमाह महीपते ।\zsay-e\*
\q1 \zsay-s |who="Arjuna"\*\zsp अर्जुन उवाच ।|who="Arjuna"\zsp*
\q1 सेनयोरुभयोर्मध्ये रथं स्थापय मेऽच्युत ॥\zsay-e\*
\v 22 \vp 22\vp* \zsay-s |who="Arjuna"\*यावदेतान्निरीक्षेऽहं योद्‌धुकामानवस्थितान् ।
\q1 कैर्मया सह योद्धव्यमस्मिन्रणसमुद्यमे ॥\zsay-e\*
\v 23 \vp 23\vp* \zsay-s |who="Arjuna"\*योत्स्यमानानवेक्षेऽहं य एतेऽत्र समागताः ।
\q1 धार्तराष्ट्रस्य दुर्बुद्धेर्युद्धे प्रियचिकीर्षवः ॥\zsay-e\*
\v 24 \vp 24\vp* \zsay-s |who="Sanjaya"\*\zsp सञ्जय उवाच ।|who="Sanjaya"\zsp*
\q1 एवमुक्तो हृषीकेशो गुडाकेशेन भारत ।
\q1 सेनयोरुभयोर्मध्ये स्थापयित्वा रथोत्तमम् ॥\zsay-e\*
\v 25 \vp 25\vp* \zsay-s |who="Sanjaya"\*भीष्मद्रोणप्रमुखतः सर्वेषां च महीक्षिताम् ।
\q1 उवाच पार्थ पश्यैतान्समवेतान्कुरूनिति ॥\zsay-e\*
\v 26 \vp 26\vp* \zsay-s |who="Sanjaya"\*तत्रापश्यत्स्थितान्पार्थः पितॄनथ पितामहान् ।
\q1 आचार्यान्मातुलान्भ्रातॄन्पुत्रान्पौत्रान्सखींस्तथा ॥\zsay-e\*
\v 27 \vp 27\vp* \zsay-s |who="Sanjaya"\*श्वशुरान्सुहृदश्चैव सेनयोरुभयोरपि ।
\q1 तान्समीक्ष्य स कौन्तेयः सर्वान्बन्धूनवस्थितान् ॥\zsay-e\*
\v 28 \vp 28\vp* \zsay-s |who="Arjuna"\*\zsp अर्जुन उवाच ।|who="Arjuna"\zsp*
\q1 दृष्ट्वेमं स्वजनं कृष्ण युयुत्सुं समुपस्थितम् ॥\zsay-e\*
\v 29 \vp 29\vp* \zsay-s |who="Arjuna"\*सीदन्ति मम गात्राणि मुखं च परिशुष्यति ।
\q1 वेपथुश्च शरीरे मे रोमहर्षश्च जायते ॥\zsay-e\*
\v 30 \vp 30\vp* \zsay-s |who="Arjuna"\*गाण्डीवं स्रंसते हस्तात्त्वक्चैव परिदह्यते ।
\q1 न च शक्नोम्यवस्थातुं भ्रमतीव च मे मनः ॥\zsay-e\*
\v 31 \vp 31\vp* \zsay-s |who="Arjuna"\*निमित्तानि च पश्यामि विपरीतानि केशव ।
\q1 न च श्रेयोऽनुपश्यामि हत्वा स्वजनमाहवे ॥\zsay-e\*
\v 32 \vp 32\vp* \zsay-s |who="Arjuna"\*न काङ्क्षे विजयं कृष्ण न च राज्यं सुखानि च ।
\q1 किं नो राज्येन गोविन्द किं भोगैर्जीवितेन वा ॥\zsay-e\*
\v 33 \vp 33\vp* \zsay-s |who="Arjuna"\*येषामर्थे काङ्क्षितं नो राज्यं भोगाः सुखानि च ।
\q1 त इमेऽवस्थिता युद्धे प्राणांस्त्यक्त्वा धनानि च ॥\zsay-e\*
\v 34 \vp 34\vp* \zsay-s |who="Arjuna"\*आचार्याः पितरः पुत्रास्तथैव च पितामहाः ।
\q1 मातुलाः श्वशुराः पौत्राः श्यालाः सम्बन्धिनस्तथा ॥\zsay-e\*
\v 35 \vp 35\vp* \zsay-s |who="Arjuna"\*एतान्न हन्तुमिच्छामि घ्नतोऽपि मधुसूदन ।
\q1 अपि त्रैलोक्यराज्यस्य हेतोः किं नु महीकृते ॥\zsay-e\*
\v 36 \vp 36\vp* \zsay-s |who="Arjuna"\*निहत्य धार्तराष्ट्रान्नः का प्रीतिः स्याज्जनार्दन ।
\q1 पापमेवाश्रयेदस्मान्हत्वैतानाततायिनः ॥\zsay-e\*
\v 37 \vp 37\vp* \zsay-s |who="Arjuna"\*तस्मान्नार्हा वयं हन्तुं धार्तराष्ट्रान्स्वबान्धवान् ।
\q1 स्वजनं हि कथं हत्वा सुखिनः स्याम माधव ॥\zsay-e\*
\v 38 \vp 38\vp* \zsay-s |who="Arjuna"\*यद्यप्येते न पश्यन्ति लोभोपहतचेतसः ।
\q1 कुलक्षयकृतं दोषं मित्रद्रोहे च पातकम् ॥\zsay-e\*
\v 39 \vp 39\vp* \zsay-s |who="Arjuna"\*कथं न ज्ञेयमस्माभिः पापादस्मान्निवर्तितुम् ।
\q1 कुलक्षयकृतं दोषं प्रपश्यद्भिर्जनार्दन ॥\zsay-e\*
\v 40 \vp 40\vp* \zsay-s |who="Arjuna"\*कुलक्षये प्रणश्यन्ति कुलधर्माः सनातनाः ।
\q1 धर्मे नष्टे कुलं कृत्स्नमधर्मोऽभिभवत्युत ॥\zsay-e\*
\v 41 \vp 41\vp* \zsay-s |who="Arjuna"\*अधर्माभिभवात्कृष्ण प्रदुष्यन्ति कुलस्त्रियः ।
\q1 स्त्रीषु दुष्टासु वार्ष्णेय जायते वर्णसङ्करः ॥\zsay-e\*
\v 42 \vp 42\vp* \zsay-s |who="Arjuna"\*सङ्करो नरकायैव कुलघ्नानां कुलस्य च ।
\q1 पतन्ति पितरो ह्येषां लुप्तपिण्डोदकक्रियाः ॥\zsay-e\*
\v 43 \vp 43\vp* \zsay-s |who="Arjuna"\*दोषैरेतैः कुलघ्नानां वर्णसङ्करकारकैः ।
\q1 उत्साद्यन्ते जातिधर्माः कुलधर्माश्च शाश्वताः ॥\zsay-e\*
\v 44 \vp 44\vp* \zsay-s |who="Arjuna"\*उत्सन्नकुलधर्माणां मनुष्याणां जनार्दन ।
\q1 नरके नियतं वासो भवतीत्यनुशुश्रुम ॥\zsay-e\*
\v 45 \vp 45\vp* \zsay-s |who="Arjuna"\*अहो बत महत्पापं कर्तुं व्यवसिता वयम् ।
\q1 यद्राज्यसुखलोभेन हन्तुं स्वजनमुद्यताः ॥\zsay-e\*
\v 46 \vp 46\vp* \zsay-s |who="Arjuna"\*यदि मामप्रतीकारमशस्त्रं शस्त्रपाणयः ।
\q1 धार्तराष्ट्रा रणे हन्युस्तन्मे क्षेमतरं भवेत् ॥\zsay-e\*
\v 47 \vp 47\vp* \zsay-s |who="Sanjaya"\*\zsp सञ्जय उवाच ।|who="Sanjaya"\zsp*
\q1 एवमुक्त्वाऽर्जुनः सङ्ख्ये रथोपस्थ उपाविशत् ।
\q1 विसृज्य सशरं चापं शोकसंविग्नमानसः ॥\zsay-e\*
\c 2
\cp 2
\p
\v 1 \vp 1\vp* \zsay-s |who="Sanjaya"\*\zsp सञ्जय उवाच ।|who="Sanjaya"\zsp*
\q1 तं तथा कृपयाऽऽविष्टमश्रुपूर्णाकुलेक्षणम् ।
\q1 विषीदन्तमिदं वाक्यमुवाच मधुसूदनः ॥\zsay-e\*
\v 2 \vp 2\vp* \zsay-s |who="The Blessed Lord"\*\zsp श्रीभगवानुवाच ।|who="The Blessed Lord"\zsp*
\q1 कुतस्त्वा कश्मलमिदं विषमे समुपस्थितम् ।
\q1 अनार्यजुष्टमस्वर्ग्यमकीर्तिकरमर्जुन ॥\zsay-e\*
\v 3 \vp 3\vp* \zsay-s |who="The Blessed Lord"\*क्लैव्यं मा स्म गमः पार्थ नैतत्त्वय्युपपद्यते ।
\q1 क्षुद्रं हृदयदौर्बल्यं त्यक्त्वोत्तिष्ट परन्तप ॥\zsay-e\*
\v 4 \vp 4\vp* \zsay-s |who="Arjuna"\*\zsp अर्जुन उवाच ।|who="Arjuna"\zsp*
\q1 कथं भीष्ममहं सङ्ख्ये द्रोणं च मधुसूदन ।
\q1 इषुभिः प्रतियोत्स्यामि पूजार्हावरिसूदन ॥\zsay-e\*
\v 5 \vp 5\vp* \zsay-s |who="Arjuna"\*गुरूनहत्वा हि महानुभावान् श्रेयो भोक्तुं भैक्ष्यमपीह लोके ।
\q1 हत्वाऽर्थकामांस्तु गुरूनिहैव भुञ्जीय भोगान्रुधिरप्रदिग्धान् ॥\zsay-e\*
\v 6 \vp 6\vp* \zsay-s |who="Arjuna"\*न चैतद्विद्मः कतरन्नो गरीयो यद्वा जयेम यदि वा नो जयेयुः ।
\q1 यानेव हत्वा न जिजीविषाम: तेऽवस्थिताः प्रमुखे धार्तराष्ट्राः ॥\zsay-e\*
\v 7 \vp 7\vp* \zsay-s |who="Arjuna"\*कार्पण्यदोषोपहतस्वभावः पृच्छामि त्वां धर्मसम्मूढचेताः ।
\q1 यच्छ्रेयः स्यान्निश्चितं ब्रूहि तन्मे शिष्यस्तेऽहं शाधि मां त्वां प्रपन्नम् ॥\zsay-e\*
\v 8 \vp 8\vp* \zsay-s |who="Arjuna"\*न हि प्रपश्यामि ममापनुद्याद्यच्छोकमुच्छोषणमिन्द्रियाणाम् ।
\q1 अवाप्य भूमावसपत्नमृद्धं राज्यं सुराणामपि चाधिपत्यम् ॥\zsay-e\*
\v 9 \vp 9\vp* \zsay-s |who="Sanjaya"\*\zsp सञ्जय उवाच ।|who="Sanjaya"\zsp*
\q1 एवमुक्त्वा हृषीकेशं गुडाकेशः परन्तपः ।
\q1 न योत्स्य इति गोविन्दमुक्त्वा तूष्णीं बभूव ह ॥\zsay-e\*
\v 10 \vp 10\vp* \zsay-s |who="Sanjaya"\*तमुवाच हृषीकेशः प्रहसन्निव भारत ।
\q1 सेनयोरुभयोर्मध्ये विषीदन्तमिदं वचः ॥\zsay-e\*
\v 11 \vp 11\vp* \zsay-s |who="The Blessed Lord"\*\zsp श्रीभगवानुवाच ।|who="The Blessed Lord"\zsp*
\q1 अशोच्यानन्वशोचस्त्वं प्रज्ञावादांश्च भाषसे ।
