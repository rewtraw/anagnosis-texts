\v 1 \vp 1\vp* \zsay-s |who="Arjuna"\*\zsp अर्जुन उवाच ।|who="Arjuna"\zsp*
\q1 संन्यासं कर्मणां कृष्ण पुनर्योगं च शंससि ।
\q1 यच्छ्रेय एतयोरेकं तन्मे ब्रूहि सुनिश्चितम् ॥\zsay-e\*
\v 2 \vp 2\vp* \zsay-s |who="The Blessed Lord"\*\zsp श्रीभगवानुवाच ।|who="The Blessed Lord"\zsp*
\q1 संन्यासः कर्मयोगश्च निःश्रेयसकरावुभौ ।
\q1 तयोस्तु कर्मसंन्यासात्कर्मयोगो विशिष्यते ॥\zsay-e\*
\v 3 \vp 3\vp* \zsay-s |who="The Blessed Lord"\*ज्ञेयः स नित्यसंन्यासी यो न द्वेष्टि न काङ्क्षति ।
\q1 निर्द्वन्द्वो हि महाबाहो सुखं बन्धात्प्रमुच्यते ॥\zsay-e\*
\v 4 \vp 4\vp* \zsay-s |who="The Blessed Lord"\*साङ्ख्ययोगौ पृथग्बालाः प्रवदन्ति न पण्डिताः ।
\q1 एकमप्यास्थितः सम्यगुभयोर्विन्दते फलम् ॥\zsay-e\*
\v 5 \vp 5\vp* \zsay-s |who="The Blessed Lord"\*यत्साङ्ख्यैः प्राप्यते स्थानं तद्योगैरपि गम्यते ।
\q1 एकं साङ्ख्यं च योगं च यः पश्यति स पश्यति ॥\zsay-e\*
\v 6 \vp 6\vp* \zsay-s |who="The Blessed Lord"\*संन्यासस्तु महाबाहो दुःखमाप्तुमयोगतः ।
\q1 योगयुक्तो मुनिर्ब्रह्म न चिरेणाधिगच्छति ॥\zsay-e\*
\v 7 \vp 7\vp* \zsay-s |who="The Blessed Lord"\*योगयुक्तो विशुद्धात्मा विजितात्मा जितेन्द्रियः ।
\q1 सर्वभूतात्मभूतात्मा कुर्वन्नपि न लिप्यते ॥\zsay-e\*
\v 8 \vp 8\vp* \zsay-s |who="The Blessed Lord"\*नैव किञ्चित्करोमीति युक्तो मन्येत तत्त्ववित् ।
\q1 पश्यन्शृण्वन्स्पृशञ्जिघ्रन्नश्नन्गच्छन्श्वसन्स्वपन् ॥\zsay-e\*
\v 9 \vp 9\vp* \zsay-s |who="The Blessed Lord"\*प्रलपन्विसृजन्गृह्णन्नुन्मिषन्निमिषन्नपि ।
\q1 इन्द्रियाणीन्द्रियार्थेषु वर्तन्त इति धारयन् ॥\zsay-e\*
\v 10 \vp 10\vp* \zsay-s |who="The Blessed Lord"\*ब्रह्मण्याधाय कर्माणि सङ्गं त्यक्त्वा करोति यः ।
\q1 लिप्यते न स पापेन पद्मपत्रमिवाम्भसा ॥\zsay-e\*
\v 11 \vp 11\vp* \zsay-s |who="The Blessed Lord"\*कायेन मनसा बुद्ध्या केवलैरिन्द्रियैरपि ।
\q1 योगिनः कर्म कुर्वन्ति सङ्गं त्यक्त्वाऽऽत्मशुद्धये ॥\zsay-e\*
\v 12 \vp 12\vp* \zsay-s |who="The Blessed Lord"\*युक्तः कर्मफलं त्यक्त्वा शान्तिमाप्नोति नैष्ठिकीम् ।
\q1 अयुक्तः कामकारेण फले सक्तो निबध्यते ॥\zsay-e\*
\v 13 \vp 13\vp* \zsay-s |who="The Blessed Lord"\*सर्वकर्माणि मनसा संन्यस्यास्ते सुखं वशी ।
\q1 नवद्वारे पुरे देही नैव कुर्वन्न कारयन् ॥\zsay-e\*
\v 14 \vp 14\vp* \zsay-s |who="The Blessed Lord"\*न कर्तृत्वं न कर्माणि लोकस्य सृजति प्रभुः ।
\q1 न कर्मफलसंयोगं स्वभावस्तु प्रवर्तते ॥\zsay-e\*
\v 15 \vp 15\vp* \zsay-s |who="The Blessed Lord"\*नादत्ते कस्यचित्पापं न चैव सुकृतं विभुः ।
\q1 अज्ञानेनावृतं ज्ञानं तेन मुह्यन्ति जन्तवः ॥\zsay-e\*
\v 16 \vp 16\vp* \zsay-s |who="The Blessed Lord"\*ज्ञानेन तु तदज्ञानं येषां नाशितमात्मनः ।
\q1 तेषामादित्यवज्ज्ञानं प्रकाशयति तत्परम् ॥\zsay-e\*
\v 17 \vp 17\vp* \zsay-s |who="The Blessed Lord"\*तद्बुद्धयस्तदात्मानस्तन्निष्ठास्तत्परायणाः ।
\q1 गच्छन्त्यपुनरावृत्तिं ज्ञाननिर्धूतकल्मषाः ॥\zsay-e\*
\v 18 \vp 18\vp* \zsay-s |who="The Blessed Lord"\*विद्याविनयसम्पन्ने ब्राह्मणे गवि हस्तिनि ।
\q1 शुनि चैव श्वपाके च पण्डिताः समदर्शिनः ॥\zsay-e\*
\v 19 \vp 19\vp* \zsay-s |who="The Blessed Lord"\*इहैव तैर्जितः सर्गो येषां साम्ये स्थितं मनः ।
\q1 निर्दोषं हि समं ब्रह्म तस्माद्ब्रह्मणि ते स्थिताः ॥\zsay-e\*
\v 20 \vp 20\vp* \zsay-s |who="The Blessed Lord"\*न प्रहृष्येत्प्रियं प्राप्य नोद्विजेत्प्राप्य चाप्रियम् ।
\q1 स्थिरबुद्धिरसंमूढो ब्रह्मविद्ब्रह्मणि स्थितः ॥\zsay-e\*
\v 21 \vp 21\vp* \zsay-s |who="The Blessed Lord"\*बाह्यस्पर्शेष्वसक्तात्मा विन्दत्यात्मनि यत्सुखम् ।
\q1 स ब्रह्मयोगयुक्तात्मा सुखमक्षयमश्नुते ॥\zsay-e\*
\v 22 \vp 22\vp* \zsay-s |who="The Blessed Lord"\*ये हि संस्पर्शजा भोगा दुःखयोनय एव ते ।
\q1 आद्यन्तवन्तः कौन्तेय न तेषु रमते बुधः ॥\zsay-e\*
\v 23 \vp 23\vp* \zsay-s |who="The Blessed Lord"\*शक्नोतीहैव यः सोढुं प्राक् शरीरविमोक्षणात् ।
\q1 कामक्रोधोद्भवं वेगं स युक्तः स सुखी नरः ॥\zsay-e\*
\v 24 \vp 24\vp* \zsay-s |who="The Blessed Lord"\*योऽन्तःसुखोऽन्तरारामस्तथान्तर्ज्योतिरेव यः ।
\q1 स योगी ब्रह्मनिर्वाणं ब्रह्मभूतोऽधिगच्छति ॥\zsay-e\*
\v 25 \vp 25\vp* \zsay-s |who="The Blessed Lord"\*लभन्ते ब्रह्मनिर्वाणमृषयः क्षीणकल्मषाः ।
\q1 छिन्नद्वैधा यतात्मानः सर्वभूतहिते रताः ॥\zsay-e\*
\v 26 \vp 26\vp* \zsay-s |who="The Blessed Lord"\*कामक्रोधवियुक्तानां यतीनां यतचेतसाम् ।
\q1 अभितो ब्रह्मनिर्वाणं वर्तते विदितात्मनाम् ॥\zsay-e\*
\v 27 \vp 27\vp* \zsay-s |who="The Blessed Lord"\*स्पर्शान्कृत्वा बहिर्बाह्यांश्चक्षुश्चैवान्तरे भ्रुवोः ।
\q1 प्राणापानौ समौ कृत्वा नासाभ्यन्तरचारिणौ ॥\zsay-e\*
\v 28 \vp 28\vp* \zsay-s |who="The Blessed Lord"\*यतेन्द्रियमनोबुद्धिर्मुनिर्मोक्षपरायणः ।
\q1 विगतेच्छाभयक्रोधो यः सदा मुक्त एव सः ॥\zsay-e\*
\v 29 \vp 29\vp* \zsay-s |who="The Blessed Lord"\*भोक्तारं यज्ञतपसां सर्वलोकमहेश्वरम् ।
\q1 सुहृदं सर्वभूतानां ज्ञात्वा मां शान्तिमृच्छति ॥\zsay-e\*
