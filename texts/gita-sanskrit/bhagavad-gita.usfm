\v 4 \vp 4\vp* \zsay-s |who="The Blessed Lord"\*संनियम्येन्द्रियग्रामं सर्वत्र समबुद्धयः ।
\q1 ते प्राप्नुवन्ति मामेव सर्वभूतहिते रताः ॥\zsay-e\*
\v 5 \vp 5\vp* \zsay-s |who="The Blessed Lord"\*क्लेशोऽधिकतरस्तेषामव्यक्तासक्तचेतसाम् ।
\q1 अव्यक्ता हि गतिर्दुःखं देहवद्भिरवाप्यते ॥\zsay-e\*
\v 6 \vp 6\vp* \zsay-s |who="The Blessed Lord"\*ये तु सर्वाणि कर्माणि मयि संन्यस्य मत्पराः ।
\q1 अनन्येनैव योगेन मां ध्यायन्त उपासते ॥\zsay-e\*
\v 7 \vp 7\vp* \zsay-s |who="The Blessed Lord"\*तेषामहं समुद्धर्ता मृत्युसंसारसागरात् ।
\q1 भवामि न चिरात्पार्थ मय्यावेशितचेतसाम् ॥\zsay-e\*
\v 8 \vp 8\vp* \zsay-s |who="The Blessed Lord"\*मय्येव मन आधत्स्व मयि बुद्धिं निवेशय ।
\q1 निवसिष्यसि मय्येव अत ऊर्ध्वं न संशयः ॥\zsay-e\*
\v 9 \vp 9\vp* \zsay-s |who="The Blessed Lord"\*अथ चित्तं समाधातुं न शक्नोषि मयि स्थिरम् ।
\q1 अभ्यासयोगेन ततो मामिच्छाप्तुं धनञ्जय ॥\zsay-e\*
\v 10 \vp 10\vp* \zsay-s |who="The Blessed Lord"\*अभ्यासेऽप्यसमर्थोऽसि मत्कर्मपरमो भव ।
\q1 मदर्थमपि कर्माणि कुर्वन्सिद्धिमवाप्स्यसि ॥\zsay-e\*
\v 11 \vp 11\vp* \zsay-s |who="The Blessed Lord"\*अथैतदप्यशक्तोऽसि कर्तुं मद्योगमाश्रितः ।
\q1 सर्वकर्मफलत्यागं ततः कुरु यतात्मवान् ॥\zsay-e\*
\v 12 \vp 12\vp* \zsay-s |who="The Blessed Lord"\*श्रेयो हि ज्ञानमभ्यासाज्ज्ञानाद्ध्यानं विशिष्यते ।
\q1 ध्यानात्कर्मफलत्यागस्त्यागाच्छान्तिरनन्तरम् ॥\zsay-e\*
\v 13 \vp 13\vp* \zsay-s |who="The Blessed Lord"\*अद्वेष्टा सर्वभूतानां मैत्रः करुण एव च ।
\q1 निर्ममो निरहङ्कारः समदुःखसुखः क्षमी ॥\zsay-e\*
\v 14 \vp 14\vp* \zsay-s |who="The Blessed Lord"\*सन्तुष्टः सततं योगी यतात्मा दृढनिश्चयः ।
\q1 मय्यर्पितमनोबुद्धिर्यो मे भक्तः स मे प्रियः ॥\zsay-e\*
\v 15 \vp 15\vp* \zsay-s |who="The Blessed Lord"\*यस्मान्नोद्विजते लोको लोकान्नोद्विजते च यः ।
\q1 हर्षामर्षभयोद्वेगैर्मुक्तो यः स च मे प्रियः ॥\zsay-e\*
\v 16 \vp 16\vp* \zsay-s |who="The Blessed Lord"\*अनपेक्षः शुचिर्दक्ष उदासीनो गतव्यथः ।
\q1 सर्वारम्भपरित्यागी यो मद्भक्तः स मे प्रियः ॥\zsay-e\*
\v 17 \vp 17\vp* \zsay-s |who="The Blessed Lord"\*यो न हृष्यति न द्वेष्टि न शोचति न काङ्क्षति ।
\q1 शुभाशुभपरित्यागी भक्तिमान्यः स मे प्रियः ॥\zsay-e\*
\v 18 \vp 18\vp* \zsay-s |who="The Blessed Lord"\*समः शत्रौ च मित्रे च तथा मानपमानयोः ।
\q1 शीतोष्णसुखदुःखेषु समः सङ्गविवर्जितः ॥\zsay-e\*
\v 19 \vp 19\vp* \zsay-s |who="The Blessed Lord"\*तुल्यनिन्दास्तुतिर्मौनी सन्तुष्टो येनकेनचित् ।
\q1 अनिकेतः स्थिरमतिर्भक्तिमान्मे प्रियो नरः ॥\zsay-e\*
\v 20 \vp 20\vp* \zsay-s |who="The Blessed Lord"\*ये तु धर्म्यामृतमिदं यथोक्तं पर्युपासते ।
\q1 श्रद्दधाना मत्परमा भक्तास्तेऽतीव मे प्रियाः ॥\zsay-e\*
\c 13
\cp 13
\p
\v 1 \vp 1\vp* \zsay-s |who="Arjuna"\*\zsp अर्जुन उवाच ।|who="Arjuna"\zsp*
\q1 प्रकृतिं पुरुषं चैव क्षेत्रं क्षेत्रज्ञमेव च ।
\q1 एतद्वेदितुमिच्छामि ज्ञानं ज्ञेयं च केशव ॥\zsay-e\*
\v 2 \vp 2\vp* \zsay-s |who="The Blessed Lord"\*\zsp श्रीभगवानुवाच ।|who="The Blessed Lord"\zsp*
\q1 इदं शरीरं कौन्तेय क्षेत्रमित्यभिधीयते ।
\q1 एतद्यो वेत्ति तं प्राहुः क्षेत्रज्ञ इति तद्विदः ॥\zsay-e\*
\v 3 \vp 3\vp* \zsay-s |who="The Blessed Lord"\*क्षेत्रज्ञं चापि मां विद्धि सर्वक्षेत्रेषु भारत ।
\q1 क्षेत्रक्षेत्रज्ञयोर्ज्ञानं यत्तज्ज्ञानं मतं मम ॥\zsay-e\*
\v 4 \vp 4\vp* \zsay-s |who="The Blessed Lord"\*तत्क्षेत्रं यच्च यादृक् च यद्विकारि यतश्च यत् ।
\q1 स च यो यत्प्रभावश्च तत्समासेन मे शृणु ॥\zsay-e\*
\v 5 \vp 5\vp* \zsay-s |who="The Blessed Lord"\*ऋषिभिर्बहुधा गीतं छन्दोभिर्विविधैः पृथक् ।
\q1 ब्रह्मसूत्रपदैश्चैव हेतुमद्भिर्विनिश्चितैः ॥\zsay-e\*
\v 6 \vp 6\vp* \zsay-s |who="The Blessed Lord"\*महाभूतान्यहङ्कारो बुद्धिरव्यक्तमेव च ।
\q1 इन्द्रियाणि दशैकं च पञ्च चेन्द्रियगोचराः ॥\zsay-e\*
\v 7 \vp 7\vp* \zsay-s |who="The Blessed Lord"\*इच्छा द्वेषः सुखं दुःखं सङ्घातश्चेतना धृतिः ।
\q1 एतत्क्षेत्रं समासेन सविकारमुदाहृतम् ॥\zsay-e\*
\v 8 \vp 8\vp* \zsay-s |who="The Blessed Lord"\*अमानित्वमदम्भित्वमहिंसा क्षान्तिरार्जवम् ।
\q1 आचार्योपासनं शौचं स्थैर्यमात्मविनिग्रहः ॥\zsay-e\*
\v 9 \vp 9\vp* \zsay-s |who="The Blessed Lord"\*इन्द्रियार्थेषु वैराग्यमनहङ्कार एव च ।
\q1 जन्ममृत्युजराव्याधिदुःखदोषानुदर्शनम् ॥\zsay-e\*
\v 10 \vp 10\vp* \zsay-s |who="The Blessed Lord"\*असक्तिरनभिष्वङ्गः पुत्रदारगृहादिषु ।
\q1 नित्यं च समचित्तत्वमिष्टानिष्टोपपत्तिषु ॥\zsay-e\*
\v 11 \vp 11\vp* \zsay-s |who="The Blessed Lord"\*मयि चानन्ययोगेन भक्तिरव्यभिचारिणी ।
\q1 विविक्तदेशसेवित्वमरतिर्जनसंसदि ॥\zsay-e\*
\v 12 \vp 12\vp* \zsay-s |who="The Blessed Lord"\*अध्यात्मज्ञाननित्यत्वं तत्त्वज्ञानार्थदर्शनम् ।
\q1 एतज्ज्ञानमिति प्रोक्तमज्ञानं यदतोऽन्यथा ॥\zsay-e\*
\v 13 \vp 13\vp* \zsay-s |who="The Blessed Lord"\*ज्ञेयं यत्तत्प्रवक्ष्यामि यज्ज्ञात्वाऽमृतमश्नुते ।
\q1 अनादिमत्परं ब्रह्म न सत्तन्नासदुच्यते ॥\zsay-e\*
\v 14 \vp 14\vp* \zsay-s |who="The Blessed Lord"\*सर्वतः पाणिपादं तत्सर्वतोऽक्षिशिरोमुखम् ।
\q1 सर्वतः श्रुतिमल्लोके सर्वमावृत्य तिष्ठति ॥\zsay-e\*
\v 15 \vp 15\vp* \zsay-s |who="The Blessed Lord"\*सर्वेन्द्रियगुणाभासं सर्वेन्द्रियविवर्जितम् ।
\q1 असक्तं सर्वभृच्चैव निर्गुणं गुणभोक्तृ च ॥\zsay-e\*
\v 16 \vp 16\vp* \zsay-s |who="The Blessed Lord"\*बहिरन्तश्च भूतानामचरं चरमेव च ।
\q1 सूक्ष्मत्वात्तदविज्ञेयं दूरस्थं चान्तिके च तत् ॥\zsay-e\*
\v 17 \vp 17\vp* \zsay-s |who="The Blessed Lord"\*अविभक्तं च भूतेषु विभक्तमिव च स्थितम् ।
\q1 भूतभर्तृ च तज्ज्ञेयं ग्रसिष्णु प्रभविष्णु च ॥\zsay-e\*
\v 18 \vp 18\vp* \zsay-s |who="The Blessed Lord"\*ज्योतिषामपि तज्ज्योतिस्तमसः परमुच्यते ।
\q1 ज्ञानं ज्ञेयं ज्ञानगम्यं हृदि सर्वस्य धिष्ठितम् ॥\zsay-e\*
\v 19 \vp 19\vp* \zsay-s |who="The Blessed Lord"\*इति क्षेत्रं तथा ज्ञानं ज्ञेयं चोक्तं समासतः ।
\q1 मद्भक्त एतद्विज्ञाय मद्भावायोपपद्यते ॥\zsay-e\*
\v 20 \vp 20\vp* \zsay-s |who="The Blessed Lord"\*प्रकृतिं पुरुषं चैव विद्ध्यनादी उभावपि ।
\q1 विकारांश्च गुणांश्चैव विद्धि प्रकृतिसंभवान् ॥\zsay-e\*
\v 21 \vp 21\vp* \zsay-s |who="The Blessed Lord"\*कार्यकारणकर्तृत्वे हेतुः प्रकृतिरुच्यते ।
\q1 पुरुषः सुखदुःखानां भोक्तृत्वे हेतुरुच्यते ॥\zsay-e\*
\v 22 \vp 22\vp* \zsay-s |who="The Blessed Lord"\*पुरुषः प्रकृतिस्थो हि भुङ्‌क्ते प्रकृतिजान्गुणान् ।
\q1 कारणं गुणसङ्गोऽस्य सदसद्योनिजन्मसु ॥\zsay-e\*
\v 23 \vp 23\vp* \zsay-s |who="The Blessed Lord"\*उपद्रष्टाऽनुमन्ता च भर्ता भोक्ता महेश्वरः ।
\q1 परमात्मेति चाप्युक्तो देहेऽस्मिन्पुरुषः परः ॥\zsay-e\*
\v 24 \vp 24\vp* \zsay-s |who="The Blessed Lord"\*य एवं वेत्ति पुरुषं प्रकृतिं च गुणैः सह ।
\q1 सर्वथा वर्तमानोऽपि न स भूयोऽभिजायते ॥\zsay-e\*
\v 25 \vp 25\vp* \zsay-s |who="The Blessed Lord"\*ध्यानेनात्मनि पश्यन्ति केचिदात्मानमात्मना ।
\q1 अन्ये साङ्ख्येन योगेन कर्मयोगेन चापरे ॥\zsay-e\*
\v 26 \vp 26\vp* \zsay-s |who="The Blessed Lord"\*अन्ये त्वेवमजानन्तः श्रुत्वाऽन्येभ्य उपासते ।
\q1 तेऽपि चातितरन्त्येव मृत्युं श्रुतिपरायणाः ॥\zsay-e\*
\v 27 \vp 27\vp* \zsay-s |who="The Blessed Lord"\*यावत्सञ्जायते किञ्चित्सत्त्वं स्थावरजङ्गमम् ।
\q1 क्षेत्रक्षेत्रज्ञसंयोगात्तद्विद्धि भरतर्षभ ॥\zsay-e\*
\v 28 \vp 28\vp* \zsay-s |who="The Blessed Lord"\*समं सर्वेषु भूतेषु तिष्ठन्तं परमेश्वरम् ।
\q1 विनश्यत्स्वविनश्यन्तं यः पश्यति स पश्यति ॥\zsay-e\*
\v 29 \vp 29\vp* \zsay-s |who="The Blessed Lord"\*समं पश्यन्हि सर्वत्र समवस्थितमीश्वरम् ।
\q1 न हिनस्त्यात्मनाऽऽत्मानं ततो याति परां गतिम् ॥\zsay-e\*
\v 30 \vp 30\vp* \zsay-s |who="The Blessed Lord"\*प्रकृत्यैव च कर्माणि क्रियमाणानि सर्वशः ।
\q1 यः पश्यति तथाऽऽत्मानमकर्तारं स पश्यति ॥\zsay-e\*
\v 31 \vp 31\vp* \zsay-s |who="The Blessed Lord"\*यदा भूतपृथग्भावमेकस्थमनुपश्यति ।
\q1 तत एव च विस्तारं ब्रह्म संपद्यते तदा ॥\zsay-e\*
\v 32 \vp 32\vp* \zsay-s |who="The Blessed Lord"\*अनादित्वान्निर्गुणत्वात्परमात्माऽयमव्ययः ।
\q1 शरीरस्थोऽपि कौन्तेय न करोति न लिप्यते ॥\zsay-e\*
\v 33 \vp 33\vp* \zsay-s |who="The Blessed Lord"\*यथा सर्वगतं सौक्ष्म्यादाकाशं नोपलिप्यते ।
\q1 सर्वत्रावस्थितो देहे तथाऽऽमा नोपलिप्यते ॥\zsay-e\*
\v 34 \vp 34\vp* \zsay-s |who="The Blessed Lord"\*यथा प्रकाशयत्येकः कृत्स्नं लोकमिमं रविः ।
\q1 क्षेत्रं क्षेत्री तथा कृत्स्नं प्रकाशयति भारत ॥\zsay-e\*
\v 35 \vp 35\vp* \zsay-s |who="The Blessed Lord"\*क्षेत्रक्षेत्रज्ञयोरेवमन्तरं ज्ञानचक्षुषा ।
\q1 भूतप्रकृतिमोक्षं च ये विदुर्यान्ति ते परम् ॥\zsay-e\*
\c 14
\cp 14
\p
\v 1 \vp 1\vp* \zsay-s |who="The Blessed Lord"\*\zsp श्रीभगवानुवाच ।|who="The Blessed Lord"\zsp*
\q1 परं भूयः प्रवक्ष्यामि ज्ञानानां ज्ञानमुत्तमम् ।
\q1 यज्ज्ञात्वा मुनयः सर्वे परां सिद्धिमितो गताः ॥\zsay-e\*
\v 2 \vp 2\vp* \zsay-s |who="The Blessed Lord"\*इदं ज्ञानमुपाश्रित्य मम साधर्म्यमागताः ।
\q1 सर्गेऽपि नोपजायन्ते प्रलये न व्यथन्ति च ॥\zsay-e\*
\v 3 \vp 3\vp* \zsay-s |who="The Blessed Lord"\*मम योनिर्महद्ब्रह्म तस्मिन् गर्भं दधाम्यहम् ।
\q1 सम्भवः सर्वभूतानां ततो भवति भारत ॥\zsay-e\*
\v 4 \vp 4\vp* \zsay-s |who="The Blessed Lord"\*सर्वयोनिषु कौन्तेय मूर्तयः संभवन्ति याः ।
\q1 तासां ब्रह्म महद्योनिरहं बीजप्रदः पिता ॥\zsay-e\*
\v 5 \vp 5\vp* \zsay-s |who="The Blessed Lord"\*सत्त्वं रजस्तम इति गुणाः प्रकृतिसंभवाः ।
\q1 निबध्नन्ति महाबाहो देहे देहिनमव्ययम् ॥\zsay-e\*
\v 6 \vp 6\vp* \zsay-s |who="The Blessed Lord"\*तत्र सत्त्वं निर्मलत्वात्प्रकाशकमनामयम् ।
\q1 सुखसङ्गेन बध्नाति ज्ञानसङ्गेन चानघ ॥\zsay-e\*
\v 7 \vp 7\vp* \zsay-s |who="The Blessed Lord"\*रजो रागात्मकं विद्धि तृष्णासङ्गसमुद्भवम् ।
\q1 तन्निबध्नाति कौन्तेय कर्मसङ्गेन देहिनम् ॥\zsay-e\*
\v 8 \vp 8\vp* \zsay-s |who="The Blessed Lord"\*तमस्त्वज्ञानजं विद्धि मोहनं सर्वदेहिनाम् ।
\q1 प्रमादालस्यनिद्राभिस्तन्निबध्नाति भारत ॥\zsay-e\*
\v 9 \vp 9\vp* \zsay-s |who="The Blessed Lord"\*सत्त्वं सुखे सञ्जयति रजः कर्मणि भारत ।
