\p
\v 1 \vp 1\vp* \zsay-s |who="The Blessed Lord"\*\zsp श्रीभगवानुवाच ।|who="The Blessed Lord"\zsp*
\q1 इदं तु ते गुह्यतमं प्रवक्ष्याम्यनसूयवे ।
\q1 ज्ञानं विज्ञानसहितं यज्ज्ञात्वा मोक्ष्यसेऽशुभात् ॥\zsay-e\*
\v 2 \vp 2\vp* \zsay-s |who="The Blessed Lord"\*राजविद्या राजगुह्यं पवित्रमिदमुत्तमम् ।
\q1 प्रत्यक्षावगमं धर्म्यं सुसुखं कर्तुमव्ययम् ॥\zsay-e\*
\v 3 \vp 3\vp* \zsay-s |who="The Blessed Lord"\*अश्रद्दधानाः पुरुषा धर्मस्यास्य परन्तप ।
\q1 अप्राप्य मां निवर्तन्ते मृत्युसंसारवर्त्मनि ॥\zsay-e\*
\v 4 \vp 4\vp* \zsay-s |who="The Blessed Lord"\*मया ततमिदं सर्वं जगदव्यक्तमूर्तिना ।
\q1 मत्स्थानि सर्वभूतानि न चाहं तेष्ववस्थितः ॥\zsay-e\*
\v 5 \vp 5\vp* \zsay-s |who="The Blessed Lord"\*न च मत्स्थानि भूतानि पश्य मे योगमैश्वरम् ।
\q1 भूतभृन्न च भूतस्थो ममात्मा भूतभावनः ॥\zsay-e\*
\v 6 \vp 6\vp* \zsay-s |who="The Blessed Lord"\*यथाऽऽकाशस्थितो नित्यं वायुः सर्वत्रगो महान् ।
\q1 तथा सर्वाणि भूतानि मत्स्थानीत्युपधारय ॥\zsay-e\*
\v 7 \vp 7\vp* \zsay-s |who="The Blessed Lord"\*सर्वभूतानि कौन्तेय प्रकृतिं यान्ति मामिकाम् ।
\q1 कल्पक्षये पुनस्तानि कल्पादौ विसृजाम्यहम् ॥\zsay-e\*
\v 8 \vp 8\vp* \zsay-s |who="The Blessed Lord"\*प्रकृतिं स्वामवष्टभ्य विसृजामि पुनः पुनः ।
\q1 भूतग्राममिमं कृत्स्नमवशं प्रकृतेर्वशात् ॥\zsay-e\*
\v 9 \vp 9\vp* \zsay-s |who="The Blessed Lord"\*न च मां तानि कर्माणि निबध्नन्ति धनञ्जय ।
\q1 उदासीनवदासीनमसक्तं तेषु कर्मसु ॥\zsay-e\*
\v 10 \vp 10\vp* \zsay-s |who="The Blessed Lord"\*मयाऽध्यक्षेण प्रकृतिः सूयते सचराचरम् ।
\q1 हेतुनाऽनेन कौन्तेय जगद्विपरिवर्तते ॥\zsay-e\*
\v 11 \vp 11\vp* \zsay-s |who="The Blessed Lord"\*अवजानन्ति मां मूढा मानुषीं तनुमाश्रितम् ।
\q1 परं भावमजानन्तो मम भूतमहेश्वरम् ॥\zsay-e\*
\v 12 \vp 12\vp* \zsay-s |who="The Blessed Lord"\*मोघाशा मोघकर्माणो मोघज्ञाना विचेतसः ।
\q1 राक्षसीमासुरीं चैव प्रकृतिं मोहिनीं श्रिताः ॥\zsay-e\*
\v 13 \vp 13\vp* \zsay-s |who="The Blessed Lord"\*महात्मानस्तु मां पार्थ दैवीं प्रकृतिमाश्रिताः ।
\q1 भजन्त्यनन्यमनसो ज्ञात्वा भूतादिमव्ययम् ॥\zsay-e\*
\v 14 \vp 14\vp* \zsay-s |who="The Blessed Lord"\*सततं कीर्तयन्तो मां यतन्तश्च दृढव्रताः ।
\q1 नमस्यन्तश्च मां भक्त्या नित्ययुक्ता उपासते ॥\zsay-e\*
\v 15 \vp 15\vp* \zsay-s |who="The Blessed Lord"\*ज्ञानयज्ञेन चाप्यन्ये यजन्तो मामुपासते ।
\q1 एकत्वेन पृथक्त्वेन बहुधा विश्वतोमुखम् ॥\zsay-e\*
\v 16 \vp 16\vp* \zsay-s |who="The Blessed Lord"\*अहं क्रतुरहं यज्ञः स्वधाऽहमहमौषधम् ।
\q1 मन्त्रोऽहमहमेवाज्यमहमग्निरहं हुतम् ॥\zsay-e\*
\v 17 \vp 17\vp* \zsay-s |who="The Blessed Lord"\*पिताऽहमस्य जगतो माता धाता पितामहः ।
\q1 वेद्यं पवित्रमोङ्कार ऋक् साम यजुरेव च ॥\zsay-e\*
\v 18 \vp 18\vp* \zsay-s |who="The Blessed Lord"\*गतिर्भर्ता प्रभुः साक्षी निवासः शरणं सुहृत् ।
\q1 प्रभवः प्रलयः स्थानं निधानं बीजमव्ययम् ॥\zsay-e\*
\v 19 \vp 19\vp* \zsay-s |who="The Blessed Lord"\*तपाम्यहमहं वर्षं निगृह्णाम्युत्सृजामि च ।
\q1 अमृतं चैव मृत्युश्च सदसच्चाहमर्जुन ॥\zsay-e\*
\v 20 \vp 20\vp* \zsay-s |who="The Blessed Lord"\*त्रैविद्या मां सोमपाः पूतपापाः यज्ञैरिष्ट्वा स्वर्गतिं प्रार्थयन्ते ।
\q1 ते पुण्यमासाद्य सुरेन्द्रलोकमश्नन्ति दिव्यान्दिवि देवभोगान् ॥\zsay-e\*
\v 21 \vp 21\vp* \zsay-s |who="The Blessed Lord"\*ते तं भुक्त्वा स्वर्गलोकं विशालम्
\q1 क्षीणे पुण्ये मर्त्यलोकं विशन्ति ।
\q1 एवं त्रयीधर्ममनुप्रपन्नाः
\q1 गतागतं कामकामा लभन्ते ॥\zsay-e\*
\v 22 \vp 22\vp* \zsay-s |who="The Blessed Lord"\*अनन्याश्चिन्तयन्तो मां ये जनाः पर्युपासते ।
\q1 तेषां नित्याभियुक्तानां योगक्षेमं वहाम्यहम् ॥\zsay-e\*
\v 23 \vp 23\vp* \zsay-s |who="The Blessed Lord"\*येऽप्यन्यदेवताभक्ता यजन्ते श्रद्धयाऽन्विताः ।
\q1 तेऽपि मामेव कौन्तेय यजन्त्यविधिपूर्वकम् ॥\zsay-e\*
\v 24 \vp 24\vp* \zsay-s |who="The Blessed Lord"\*अहं हि सर्वयज्ञानां भोक्ता च प्रभुरेव च ।
\q1 न तु मामभिजानन्ति तत्त्वेनातश्च्यवन्ति ते ॥\zsay-e\*
\v 25 \vp 25\vp* \zsay-s |who="The Blessed Lord"\*यान्ति देवव्रता देवान् पितॄन्यान्ति पितृव्रताः ।
\q1 भूतानि यान्ति भूतेज्या यान्ति मद्याजिनोऽपि माम् ॥\zsay-e\*
\v 26 \vp 26\vp* \zsay-s |who="The Blessed Lord"\*पत्रं पुष्पं फलं तोयं यो मे भक्त्या प्रयच्छति ।
\q1 तदहं भक्त्युपहृतमश्नामि प्रयतात्मनः ॥\zsay-e\*
\v 27 \vp 27\vp* \zsay-s |who="The Blessed Lord"\*यत्करोषि यदश्नासि यज्जुहोषि ददासि यत् ।
\q1 यत्तपस्यसि कौन्तेय तत्कुरुष्व मदर्पणम् ॥\zsay-e\*
\v 28 \vp 28\vp* \zsay-s |who="The Blessed Lord"\*शुभाशुभफलैरेवं मोक्ष्यसे कर्मबन्धनैः ।
\q1 संन्यासयोगयुक्तात्मा विमुक्तो मामुपैष्यसि ॥\zsay-e\*
\v 29 \vp 29\vp* \zsay-s |who="The Blessed Lord"\*समोऽहं सर्वभूतेषु न मे द्वेष्योऽस्ति न प्रियः ।
\q1 ये भजन्ति तु मां भक्त्या मयि ते तेषु चाप्यहम् ॥\zsay-e\*
\v 30 \vp 30\vp* \zsay-s |who="The Blessed Lord"\*अपि चेत्सुदुराचारो भजते मामनन्यभाक् ।
\q1 साधुरेव स मन्तव्यः सम्यग्व्यवसितो हि सः ॥\zsay-e\*
\v 31 \vp 31\vp* \zsay-s |who="The Blessed Lord"\*क्षिप्रं भवति धर्मात्मा शश्वच्छान्तिं निगच्छति ।
\q1 कौन्तेय प्रतिजानीहि न मे भक्तः प्रणश्यति ॥\zsay-e\*
\v 32 \vp 32\vp* \zsay-s |who="The Blessed Lord"\*मां हि पार्थ व्यपाश्रित्य येऽपि स्युः पापयोनयः ।
\q1 स्त्रियो वैश्यास्तथा शूद्रास्तेऽपि यान्ति परां गतिम् ॥\zsay-e\*
\v 33 \vp 33\vp* \zsay-s |who="The Blessed Lord"\*किं पुनर्ब्राह्मणाः पुण्या भक्ता राजर्षयस्तथा ।
\q1 अनित्यमसुखं लोकमिमं प्राप्य भजस्व माम् ॥\zsay-e\*
\v 34 \vp 34\vp* \zsay-s |who="The Blessed Lord"\*मन्मना भव मद्भक्तो मद्याजी मां नमस्कुरु ।
\q1 मामेवैष्यसि युक्त्वैवमात्मानं मत्परायणः ॥\zsay-e\*
