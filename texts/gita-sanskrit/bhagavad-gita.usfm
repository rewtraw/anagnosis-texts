\v 1 \vp 1\vp* \zsay-s |who="Arjuna"\*\zsp अर्जुन उवाच ।|who="Arjuna"\zsp*
\q1 ज्यायसी चेत्कर्मणस्ते मता बुद्धिर्जनार्दन ।
\q1 तत्किं कर्मणि घोरे मां नियोजयसि केशव ॥\zsay-e\*
\v 2 \vp 2\vp* \zsay-s |who="Arjuna"\*व्यामिश्रेणेव वाक्येन बुद्धिं मोहयसीव मे ।
\q1 तदेकं वद निश्चित्य येन श्रेयोऽहमाप्नुयाम् ॥\zsay-e\*
\v 3 \vp 3\vp* \zsay-s |who="The Blessed Lord"\*\zsp श्रीभगवानुवाच ।|who="The Blessed Lord"\zsp*
\q1 लोकेऽस्मिन्द्विविधा निष्ठा पुरा प्रोक्ता मयाऽनघ ।
\q1 ज्ञानयोगेन साङ्ख्यानां कर्मयोगेन योगिनाम् ॥\zsay-e\*
\v 4 \vp 4\vp* \zsay-s |who="The Blessed Lord"\*न कर्मणामनारम्भान्नैष्कर्म्यं पुरुषोऽश्नुते ।
\q1 न च संन्यसनादेव सिद्धिं समधिगच्छति ॥\zsay-e\*
\v 5 \vp 5\vp* \zsay-s |who="The Blessed Lord"\*न हि कश्चित्क्षणमपि जातु तिष्ठत्यकर्मकृत् ।
\q1 कार्यते ह्यवशः कर्म सर्वः प्रकृतिजैर्गुणैः ॥\zsay-e\*
\v 6 \vp 6\vp* \zsay-s |who="The Blessed Lord"\*कर्मेन्द्रियाणि संयम्य य आस्ते मनसा स्मरन् ।
\q1 इन्द्रियार्थान्विमूढात्मा मिथ्याचारः स उच्यते ॥\zsay-e\*
\v 7 \vp 7\vp* \zsay-s |who="The Blessed Lord"\*यस्त्विन्द्रियाणि मनसा नियम्यारभतेऽर्जुन ।
\q1 कर्मेन्द्रियैः कर्मयोगमसक्तः स विशिष्यते ॥\zsay-e\*
\v 8 \vp 8\vp* \zsay-s |who="The Blessed Lord"\*नियतं कुरु कर्म त्वं कर्म ज्यायो ह्यकर्मणः ।
\q1 शरीरयात्राऽपि च ते न प्रसिध्येदकर्मणः ॥\zsay-e\*
\v 9 \vp 9\vp* \zsay-s |who="The Blessed Lord"\*यज्ञार्थात्कर्मणोऽन्यत्र लोकोऽयं कर्मबन्धनः ।
\q1 तदर्थं कर्म कौन्तेय मुक्तसङ्गः समाचर ॥\zsay-e\*
\v 10 \vp 10\vp* \zsay-s |who="The Blessed Lord"\*सहयज्ञाः प्रजाः सृष्ट्वा पुरोवाच प्रजापतिः ।
\q1 अनेन प्रसविष्यध्वमेष वोऽस्त्विष्टकामधुक् ॥\zsay-e\*
\v 11 \vp 11\vp* \zsay-s |who="The Blessed Lord"\*देवान्भावयतानेन ते देवा भावयन्तु वः ।
\q1 परस्परं भावयन्तः श्रेयः परमवाप्स्यथ ॥\zsay-e\*
\v 12 \vp 12\vp* \zsay-s |who="The Blessed Lord"\*इष्टान्भोगान्हि वो देवा दास्यन्ते यज्ञभाविताः ।
\q1 तैर्दत्तानप्रदायैभ्यो यो भुङ्क्ते स्तेन एव सः ॥\zsay-e\*
\v 13 \vp 13\vp* \zsay-s |who="The Blessed Lord"\*यज्ञशिष्टाशिनः सन्तो मुच्यन्ते सर्वकिल्बिषैः ।
\q1 भुञ्जते ते त्वघं पापा ये पचन्त्यात्मकारणात् ॥\zsay-e\*
\v 14 \vp 14\vp* \zsay-s |who="The Blessed Lord"\*अन्नाद्भवन्ति भूतानि पर्जन्यादन्नसंभवः ।
\q1 यज्ञाद्भवति पर्जन्यो यज्ञः कर्मसमुद्भवः ॥\zsay-e\*
\v 15 \vp 15\vp* \zsay-s |who="The Blessed Lord"\*कर्म ब्रह्मोद्भवं विद्धि ब्रह्माऽक्षरसमुद्भवम् ।
\q1 तस्मात्सर्वगतं ब्रह्म नित्यं यज्ञे प्रतिष्ठितम् ॥\zsay-e\*
\v 16 \vp 16\vp* \zsay-s |who="The Blessed Lord"\*एवं प्रवर्तितं चक्रं नानुवर्तयतीह यः ।
\q1 अघायुरिन्द्रियारामो मोघं पार्थ स जीवति ॥\zsay-e\*
\v 17 \vp 17\vp* \zsay-s |who="The Blessed Lord"\*यस्त्वात्मरतिरेव स्यादात्मतृप्तश्च मानवः ।
\q1 आत्मन्येव च सन्तुष्टस्तस्य कार्यं न विद्यते ॥\zsay-e\*
\v 18 \vp 18\vp* \zsay-s |who="The Blessed Lord"\*नैव तस्य कृतेनार्थो नाकृतेनेह कश्चन ।
\q1 न चास्य सर्वभूतेषु कश्चिदर्थव्यपाश्रयः ॥\zsay-e\*
\v 19 \vp 19\vp* \zsay-s |who="The Blessed Lord"\*तस्मादसक्तः सततं कार्यं कर्म समाचर ।
\q1 असक्तो ह्याचरन्कर्म परमाप्नोति पूरुषः ॥\zsay-e\*
\v 20 \vp 20\vp* \zsay-s |who="The Blessed Lord"\*कर्मणैव हि संसिद्धिमास्थिता जनकादयः ।
\q1 लोकसङ्ग्रहमेवापि सम्पश्यन्कर्तुमर्हसि ॥\zsay-e\*
\v 21 \vp 21\vp* \zsay-s |who="The Blessed Lord"\*यद्यदाचरति श्रेष्ठस्तत्तदेवेतरो जनः ।
\q1 स यत्प्रमाणं कुरुते लोकस्तदनुवर्तते ॥\zsay-e\*
\v 22 \vp 22\vp* \zsay-s |who="The Blessed Lord"\*न मे पार्थास्ति कर्तव्यं त्रिषु लोकेषु किञ्चन ।
\q1 नानवाप्तमवाप्तव्यं वर्त एव च कर्मणि ॥\zsay-e\*
\v 23 \vp 23\vp* \zsay-s |who="The Blessed Lord"\*यदि ह्यहं न वर्तेयं जातु कर्मण्यतन्द्रितः ।
\q1 मम वर्त्मानुवर्तन्ते मनुष्याः पार्थ सर्वशः ॥\zsay-e\*
\v 24 \vp 24\vp* \zsay-s |who="The Blessed Lord"\*उत्सीदेयुरिमे लोका न कुर्यां कर्म चेदहम् ।
\q1 सङ्करस्य च कर्ता स्यामुपहन्यामिमाः प्रजाः ॥\zsay-e\*
\v 25 \vp 25\vp* \zsay-s |who="The Blessed Lord"\*सक्ताः कर्मण्यविद्वांसो यथा कुर्वन्ति भारत ।
\q1 कुर्याद्विद्वांस्तथाऽसक्तश्चिकीर्षुर्लोकसङ्ग्रहम् ॥\zsay-e\*
\v 26 \vp 26\vp* \zsay-s |who="The Blessed Lord"\*न बुद्धिभेदं जनयेदज्ञानां कर्मसङ्गिनाम् ।
\q1 जोषयेत्सर्वकर्माणि विद्वान्युक्तः समाचरन् ॥\zsay-e\*
\v 27 \vp 27\vp* \zsay-s |who="The Blessed Lord"\*प्रकृतेः क्रियमाणानि गुणैः कर्माणि सर्वशः ।
\q1 अहङ्कारविमूढात्मा कर्ताऽहमिति मन्यते ॥\zsay-e\*
\v 28 \vp 28\vp* \zsay-s |who="The Blessed Lord"\*तत्त्ववित्तु महाबाहो गुणकर्मविभागयोः ।
\q1 गुणा गुणेषु वर्तन्त इति मत्वा न सज्जते ॥\zsay-e\*
\v 29 \vp 29\vp* \zsay-s |who="The Blessed Lord"\*प्रकृतेर्गुणसम्मूढाः सज्जन्ते गुणकर्मसु ।
\q1 तानकृत्स्नविदो मन्दान्कृत्स्नविन्न विचालयेत् ॥\zsay-e\*
\v 30 \vp 30\vp* \zsay-s |who="The Blessed Lord"\*मयि सर्वाणि कर्माणि संन्यस्याऽध्यात्मचेतसा ।
\q1 निराशीर्निर्ममो भूत्वा युध्यस्व विगतज्वरः ॥\zsay-e\*
\v 31 \vp 31\vp* \zsay-s |who="The Blessed Lord"\*ये मे मतमिदं नित्यमनुतिष्ठन्ति मानवाः ।
\q1 श्रद्धावन्तोऽनसूयन्तो मुच्यन्ते तेऽपि कर्मभिः ॥\zsay-e\*
\v 32 \vp 32\vp* \zsay-s |who="The Blessed Lord"\*ये त्वेतदभ्यसूयन्तो नानुतिष्ठन्ति मे मतम् ।
\q1 सर्वज्ञानविमूढांस्तान्विद्धि नष्टानचेतसः ॥\zsay-e\*
\v 33 \vp 33\vp* \zsay-s |who="The Blessed Lord"\*सदृशं चेष्टते स्वस्याः प्रकृतेर्ज्ञानवानपि ।
\q1 प्रकृतिं यान्ति भूतानि निग्रहः किं करिष्यति ॥\zsay-e\*
\v 34 \vp 34\vp* \zsay-s |who="The Blessed Lord"\*इन्द्रियस्येन्द्रियस्यार्थे रागद्वेषौ व्यवस्थितौ ।
\q1 तयोर्न वशमागच्छेत्तौ ह्यस्य परिपन्थिनौ ॥\zsay-e\*
\v 35 \vp 35\vp* \zsay-s |who="The Blessed Lord"\*श्रेयान्स्वधर्मो विगुणः परधर्मात्स्वनुष्ठितात् ।
\q1 स्वधर्मे निधनं श्रेयः परधर्मो भयावहः ॥\zsay-e\*
\v 36 \vp 36\vp* \zsay-s |who="Arjuna"\*\zsp अर्जुन उवाच ।|who="Arjuna"\zsp*
\q1 अथ केन प्रयुक्तोऽयं पापं चरति पूरुषः ।
\q1 अनिच्छन्नपि वार्ष्णेय बलादिव नियोजितः ॥\zsay-e\*
\v 37 \vp 37\vp* \zsay-s |who="The Blessed Lord"\*\zsp श्रीभगवानुवाच ।|who="The Blessed Lord"\zsp*
\q1 काम एष क्रोध एष रजोगुणसमुद्भवः ।
\q1 महाशनो महापाप्मा विद्ध्येनमिह वैरिणम् ॥\zsay-e\*
\v 38 \vp 38\vp* \zsay-s |who="The Blessed Lord"\*धूमेनाऽव्रियते वह्निर्यथाऽऽदर्शो मलेन च ।
