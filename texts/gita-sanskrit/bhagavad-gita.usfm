\cp 8
\p
\v 1 \vp 1\vp* \zsay-s |who="Arjuna"\*\zsp अर्जुन उवाच ।|who="Arjuna"\zsp*
\q1 किं तद्ब्रह्म किमध्यात्मं किं कर्म पुरुषोत्तम ।
\q1 अधिभूतं च किं प्रोक्तमधिदैवं किमुच्यते ॥\zsay-e\*
\v 2 \vp 2\vp* \zsay-s |who="Arjuna"\*अधियज्ञः कथं कोऽत्र देहेऽस्मिन्मधुसूदन ।
\q1 प्रयाणकाले च कथं ज्ञेयोऽसि नियतात्मभिः ॥\zsay-e\*
\v 3 \vp 3\vp* \zsay-s |who="The Blessed Lord"\*\zsp श्रीभगवानुवाच ।|who="The Blessed Lord"\zsp*
\q1 अक्षरं ब्रह्म परमं स्वभावोऽध्यात्ममुच्यते ।
\q1 भूतभावोद्भवकरो विसर्गः कर्मसंज्ञितः ॥\zsay-e\*
\v 4 \vp 4\vp* \zsay-s |who="The Blessed Lord"\*अधिभूतं क्षरो भावः पुरुषश्चाधिदैवतम् ।
\q1 अधियज्ञोऽहमेवात्र देहे देहभृतां वर ॥\zsay-e\*
\v 5 \vp 5\vp* \zsay-s |who="The Blessed Lord"\*अन्तकाले च मामेव स्मरन्मुक्त्वा कलेवरम् ।
\q1 यः प्रयाति स मद्भावं याति नास्त्यत्र संशयः ॥\zsay-e\*
\v 6 \vp 6\vp* \zsay-s |who="The Blessed Lord"\*यं यं वापि स्मरन्भावं त्यजत्यन्ते कलेवरम् ।
\q1 तं तमेवैति कौन्तेय सदा तद्भावभावितः ॥\zsay-e\*
\v 7 \vp 7\vp* \zsay-s |who="The Blessed Lord"\*तस्मात्सर्वेषु कालेषु मामनुस्मर युध्य च ।
\q1 मय्यर्पितमनोबुद्धिर्मामेवैष्यस्यसंशयम् ॥\zsay-e\*
\v 8 \vp 8\vp* \zsay-s |who="The Blessed Lord"\*अभ्यासयोगयुक्तेन चेतसा नान्यगामिना ।
\q1 परमं पुरुषं दिव्यं याति पार्थानुचिन्तयन् ॥\zsay-e\*
\v 9 \vp 9\vp* \zsay-s |who="The Blessed Lord"\*कविं पुराणमनुशासितारमणोरणीयांसमनुस्मरेद्यः ।
\q1 सर्वस्य धातारमचिन्त्यरूपमादित्यवर्णं तमसः परस्तात् ॥\zsay-e\*
\v 10 \vp 10\vp* \zsay-s |who="The Blessed Lord"\*प्रयाणकाले मनसाऽचलेन भक्त्या युक्तो योगबलेन चैव ।
\q1 भ्रुवोर्मध्ये प्राणमावेश्य सम्यक् स तं परं पुरुषमुपैति दिव्यम् ॥\zsay-e\*
\v 11 \vp 11\vp* \zsay-s |who="The Blessed Lord"\*यदक्षरं वेदविदो वदन्ति विशन्ति यद्यतयो वीतरागाः ।
\q1 यदिच्छन्तो ब्रह्मचर्यं चरन्ति तत्ते पदं सङ्ग्रहेण प्रवक्ष्ये ॥\zsay-e\*
\v 12 \vp 12\vp* \zsay-s |who="The Blessed Lord"\*सर्वद्वाराणि संयम्य मनो हृदि निरुध्य च ।
